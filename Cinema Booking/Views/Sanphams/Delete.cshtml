@model Cinema_Booking.Models.Sanpham

@{
    ViewData["Title"] = "Xóa sản phẩm";
}

<div class="container mt-5">

    <div class="card shadow-lg border-0">

        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">
                🗑 Xóa sản phẩm
            </h3>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4 text-center">

                    @if (!string.IsNullOrEmpty(Model.HinhAnh))
                    {
                        <img src="@Model.HinhAnh"
                             class="img-fluid rounded shadow"
                             style="max-height:250px;" />
                    }
                    else
                    {
                        <img src="/images/no-image.png"
                             class="img-fluid rounded shadow"
                             style="max-height:250px;" />
                    }

                </div>

                <div class="col-md-8">

                    <h4 class="text-danger mb-4">
                        Bạn có chắc muốn xóa sản phẩm này?
                    </h4>

                    <table class="table table-bordered">

                        <tr>
                            <th width="30%">Mã sản phẩm</th>
                            <td>@Model.MaSp</td>
                        </tr>

                        <tr>
                            <th>Tên sản phẩm</th>
                            <td>@Model.TenSp</td>
                        </tr>

                        <tr>
                            <th>Loại sản phẩm</th>
                            <td>@Model.LoaiSp</td>
                        </tr>

                        <tr>
                            <th>Đơn giá</th>
                            <td>@Model.DonGia?.ToString("N0") đ</td>
                        </tr>

                    </table>

                    <form asp-action="Delete"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="maSp"
                               value="@Model.MaSp" />

                        <button type="submit"
                                class="btn btn-danger btn-lg">

                            🗑 Xác nhận xóa

                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary btn-lg">

                            Hủy

                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>