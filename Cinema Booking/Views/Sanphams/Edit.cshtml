@model Cinema_Booking.Models.Sanpham

@{
    ViewData["Title"] = "Sửa sản phẩm";
}

<div class="container mt-4">

    <div class="card shadow-lg">

        <div class="card-header bg-warning">
            <h3 class="mb-0">
                ✏️ Sửa sản phẩm
            </h3>
        </div>

        <div class="card-body">

            <form asp-action="Edit"
                  method="post"
                  enctype="multipart/form-data">

                <input type="hidden"
                       asp-for="MaSp" />

                <div class="mb-3">
                    <label class="form-label">
                        Tên sản phẩm
                    </label>

                    <input asp-for="TenSp"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Loại sản phẩm
                    </label>

                    <input asp-for="LoaiSp"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Đơn giá
                    </label>

                    <input asp-for="DonGia"
                           class="form-control" />
                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Ảnh hiện tại
                    </label>

                    <br />

                    @if (!string.IsNullOrEmpty(Model.HinhAnh))
                    {
                        <img src="@Model.HinhAnh"
                             id="preview"
                             class="rounded shadow"
                             style="max-width:250px;" />
                    }
                    else
                    {
                        <img id="preview"
                             style="max-width:250px;display:none;"
                             class="rounded shadow" />
                    }

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Chọn ảnh mới
                    </label>

                    <input type="file"
                           name="imageFile"
                           class="form-control"
                           accept="image/*"
                           onchange="previewImage(event)" />

                </div>

                <button type="submit"
                        class="btn btn-warning">

                    💾 Cập nhật

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Quay lại

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <script>

        function previewImage(event)
        {
            const img =
                document.getElementById("preview");

            img.src =
                URL.createObjectURL(
                    event.target.files[0]);

            img.style.display =
                "block";
        }

    </script>
}