@model Cinema_Booking.Models.Taikhoan

<div class="container mt-4">

    <h2>✏️ Sửa tài khoản</h2>

    <form asp-action="Edit">

        <input type="hidden" asp-for="MaTK" />

        <div class="mb-3">
            <label>Username</label>
            <input asp-for="Username" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Email</label>
            <input asp-for="Email" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Vai trò</label>
            <select asp-for="VaiTro" class="form-control">
                <option>User</option>
                <option>Staff</option>
                <option>Admin</option>
            </select>
        </div>

        <button class="btn btn-warning">
            Cập nhật
        </button>

    </form>

</div>