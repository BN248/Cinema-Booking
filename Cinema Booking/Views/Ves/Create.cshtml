@model Cinema_Booking.Models.Ve

@{
    ViewData["Title"] = "Thêm vé";
}

<div class="container mt-4">

    <div class="card shadow border-0">

        <div class="card-header bg-success text-white">

            <h3>🎟 Thêm vé</h3>

        </div>

        <div class="card-body">

            <form asp-action="Create" method="post">

                <div class="mb-3">

                    <label class="form-label">
                        Mã vé
                    </label>

                    <input asp-for="MaV"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Suất chiếu
                    </label>

                    <select asp-for="MaSc"
                            asp-items="ViewBag.MaSc"
                            class="form-select">

                    </select>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Ghế
                    </label>

                    <select asp-for="MaG"
                            asp-items="ViewBag.MaG"
                            class="form-select">

                    </select>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Ngày đặt
                    </label>

                    <input asp-for="NgayDat"
                           type="date"
                           class="form-control" />

                </div>

                <button type="submit"
                        class="btn btn-success">

                    ➕ Thêm vé

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Quay lại

                </a>

            </form>

        </div>

    </div>

</div>