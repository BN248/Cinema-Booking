@model Cinema_Booking.Models.Ve

<div class="container mt-5">

    <div class="card shadow border-0">

        <div class="card-header bg-danger text-white">

            <h3>🗑 Xóa vé</h3>

        </div>

        <div class="card-body">

            <div class="alert alert-warning">

                Bạn có chắc muốn xóa vé này?

            </div>

            <p><b>Mã vé:</b> @Model.MaV</p>

            <p><b>Suất chiếu:</b> @Model.MaSc</p>

            <p><b>Ghế:</b> @Model.MaG</p>

            <form asp-action="Delete" method="post">

                <input type="hidden"
                       asp-for="MaV" />

                <button type="submit"
                        class="btn btn-danger">

                    Xóa

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Hủy

                </a>

            </form>

        </div>

    </div>

</div>