@model Cinema_Booking.Models.Ve

<div class="container mt-4">

    <div class="card shadow border-0">

        <div class="card-header bg-warning">

            <h3>✏️ Sửa vé</h3>

        </div>

        <div class="card-body">

            <form asp-action="Edit" method="post">

                <input type="hidden"
                       asp-for="MaV" />

                <div class="mb-3">

                    <label class="form-label">
                        Suất chiếu
                    </label>

                    <select asp-for="MaSc"
                            asp-items="ViewBag.MaSc"
                            class="form-select">

                    </select>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Ghế
                    </label>

                    <select asp-for="MaG"
                            asp-items="ViewBag.MaG"
                            class="form-select">

                    </select>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Ngày đặt
                    </label>

                    <input asp-for="NgayDat"
                           type="date"
                           class="form-control" />

                </div>

                <button type="submit"
                        class="btn btn-warning">

                    💾 Lưu

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Quay lại

                </a>

            </form>

        </div>

    </div>

</div>