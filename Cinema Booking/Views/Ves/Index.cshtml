@model IEnumerable<Cinema_Booking.Models.Ve>
@using Microsoft.AspNetCore.Http

<div class="container mt-4">

    <h1 class="text-center fw-bold mb-5">
        🎟 Danh sách vé
    </h1>

    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-md-6 mb-4">

                <div class="card shadow border-0 ticket-card">

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-center">

                            <h4 class="fw-bold text-danger">
                                @item.MaScNavigation?.MaPNavigation?.TenP
                            </h4>

                            <div>

                                @if (item.TrangThai == "Đã thanh toán")
                                {
                                    <span class="badge bg-success px-3 py-2">
                                        ✅ Đã thanh toán
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger px-3 py-2">
                                        ❌ Chưa thanh toán
                                    </span>
                                }

                            </div>

                        </div>

                        <hr />

                        <p>
                            🎫 <b>Mã vé:</b>
                            @item.MaV
                        </p>

                        <p>
                            🪑 <b>Ghế:</b>
                            @item.MaGNavigation?.HangG@item.MaGNavigation?.SoG
                        </p>

                        <p>
                            📅 <b>Ngày đặt:</b>

                            @(item.NgayDat.HasValue
                                ? item.NgayDat.Value.ToString("dd/MM/yyyy")
                                : "")
                        </p>

                        <p>
                            💰 <b>Giá vé:</b>

                            @(item.GiaVe.HasValue
                                ? item.GiaVe.Value.ToString("N0")
                                : "0") đ
                        </p>

                        <div class="mt-3 d-flex gap-2 flex-wrap">

                            <a asp-action="Details"
                               asp-route-id="@item.MaV"
                               class="btn btn-dark">

                                🔍 Chi tiết vé

                            </a>

                            @if (Context.Session.GetString("Role") == "Admin")
                            {
                                <a asp-action="Delete"
                                   asp-route-id="@item.MaV"
                                   class="btn btn-danger">

                                    🗑 Hủy vé

                                </a>
                            }

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>

<style>

.ticket-card{
    border-radius:20px;
    transition:.3s;
}

.ticket-card:hover{
    transform:translateY(-5px);
    box-shadow:0 10px 25px rgba(0,0,0,.15);
}

.ticket-card p{
    font-size:16px;
    margin-bottom:10px;
}

</style>